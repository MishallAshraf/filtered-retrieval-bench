# Session pooler connection string from your Supabase project's Connect panel.
# Percent-encode any symbols in the password. Never commit the real .env file.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Optional, only for the RPC timing in scripts/check_search_function.py.
# Project Settings > API Keys (publishable or legacy anon key) and JWT Keys (legacy JWT secret).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_JWT_SECRET=your-legacy-jwt-secret
